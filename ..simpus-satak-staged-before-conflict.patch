diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 0000000..59d2454
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,51 @@
+services:
+  postgres:
+    image: postgres:16-alpine
+    container_name: simpus_postgres
+    restart: unless-stopped
+    environment:
+      POSTGRES_USER: ${POSTGRES_USER:-postgres}
+      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
+      POSTGRES_DB: ${POSTGRES_DB:-simpus_db}
+    volumes:
+      - postgres_data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-simpus_db}"]
+      interval: 5s
+      timeout: 5s
+      retries: 5
+      start_period: 10s
+    networks:
+      - simpus_network
+
+  app:
+    build:
+      context: .
+      dockerfile: Dockerfile
+    container_name: simpus_app
+    restart: unless-stopped
+    ports:
+      - "${PORT:-3000}:3000"
+    env_file:
+      - path: .env
+        required: false
+    environment:
+      NODE_ENV: production
+      DATABASE_URL: postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-simpus_db}?schema=public
+      AUTH_SECRET: ${AUTH_SECRET:-simpus_satak_secret_key_at_least_32_characters_long_123456}
+      PORT: 3000
+      HOSTNAME: 0.0.0.0
+      RUN_MIGRATION: ${RUN_MIGRATION:-true}
+    depends_on:
+      postgres:
+        condition: service_healthy
+    networks:
+      - simpus_network
+
+volumes:
+  postgres_data:
+    driver: local
+
+networks:
+  simpus_network:
+    driver: bridge
diff --git a/docker-entrypoint.sh b/docker-entrypoint.sh
new file mode 100755
index 0000000..e31257d
--- /dev/null
+++ b/docker-entrypoint.sh
@@ -0,0 +1,11 @@
+#!/bin/sh
+set -e
+
+# Jalankan migrasi Prisma secara otomatis jika RUN_MIGRATION aktif (default: true)
+if [ "${RUN_MIGRATION:-true}" = "true" ]; then
+  echo "==> [SIMPUS] Menjalankan Prisma migrate deploy..."
+  pnpm prisma migrate deploy
+  echo "==> [SIMPUS] Migrasi database berhasil diaplikasikan."
+fi
+
+exec "$@"
diff --git a/lib/date.ts b/lib/date.ts
new file mode 100644
index 0000000..e9d611e
--- /dev/null
+++ b/lib/date.ts
@@ -0,0 +1,13 @@
+export const APP_TIMEZONE = "Asia/Makassar";
+
+/**
+ * Mengembalikan tanggal hari ini dalam format YYYY-MM-DD sesuai zona waktu Asia/Makassar (WITA, UTC+8).
+ */
+export function getTodayDateString(date: Date = new Date()): string {
+  return new Intl.DateTimeFormat("en-CA", {
+    timeZone: APP_TIMEZONE,
+    year: "numeric",
+    month: "2-digit",
+    day: "2-digit",
+  }).format(date);
+}
