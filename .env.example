# Application Settings
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Database Settings (Local / Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=simpus_db

# Database Connection URL
# Untuk Docker Compose internal: postgresql://postgres:postgres@postgres:5432/simpus_db?schema=public
# Untuk koneksi langsung dari host: postgresql://postgres:postgres@localhost:5432/simpus_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/simpus_db?schema=public

# Authentication (Wajib minimal 32 karakter)
AUTH_SECRET=simpus_satak_secret_key_at_least_32_characters_long_123456

# Migration
RUN_MIGRATION=true

# Database Seeder Credentials (Wajib minimal 12 karakter saat menjalankan seed)
SEED_ADMIN_PASSWORD=adminSimpus123
SEED_STUDENT_PASSWORD=siswaSimpus123
