// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PUSTAKAWAN
  SISWA
}

enum UserStatus {
  AKTIF
  NONAKTIF
}

enum BookStatus {
  TERSEDIA
  DIPINJAM
  RUSAK
  HILANG
}

enum LoanStatus {
  AKTIF
  SEBAGIAN_DIKEMBALIKAN
  SELESAI
  DIBATALKAN
}

enum FineType {
  TERLAMBAT
}

enum FineStatus {
  BELUM_DIBAYAR
  LUNAS
  BEBAS
}

enum PaymentMethod {
  CASH
}

model LibrarySetting {
  id              String   @id @default(uuid())
  key             String   @unique @default("DEFAULT")
  maxLoanDays     Int      @default(7)
  maxActiveCopies Int      @default(3)
  fineRatePerDay  Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("library_settings")
}

model User {
  id           String     @id @default(uuid())
  role         UserRole   @default(SISWA)
  status       UserStatus @default(AKTIF)
  username     String     @unique
  passwordHash String
  name         String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student          Student?
  processedLoans   Loan[]        @relation("LoanProcessedBy")
  receivedPayments FinePayment[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Student {
  id                String   @id @default(uuid())
  userId            String   @unique
  nis               String   @unique
  name              String
  className         String
  libraryCardNumber String   @unique
  phone             String?
  isActive          Boolean  @default(true)
  joinedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  loans Loan[]

  @@index([name])
  @@index([className])
  @@map("students")
}

model Author {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books Book[]

  @@index([name])
  @@map("authors")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  ddcCode     String   @unique
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]
  @@map("categories")
}

model Book {
  id              String   @id @default(uuid())
  isbn            String?  @unique
  title           String
  isActive        Boolean  @default(true)
  publisher       String?
  publicationYear Int?
  edition         String?
  description     String?
  coverUrl        String?
  categoryId      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category Category   @relation(fields: [categoryId], references: [id])
  authors  Author[]
  copies   BookCopy[]

  @@index([title])
  @@index([categoryId])
  @@index([isActive])
  @@map("books")
}

model Shelf {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  copies BookCopy[]

  @@map("shelves")
}

model BookCopy {
  id            String     @id @default(uuid())
  bookId        String
  shelfId       String?
  isActive      Boolean    @default(true)
  barcode       String     @unique
  status        BookStatus @default(TERSEDIA)
  conditionNote String?
  acquiredAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  book      Book       @relation(fields: [bookId], references: [id])
  shelf     Shelf?     @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  loanItems LoanItem[]

  @@index([bookId])
  @@index([shelfId])
  @@index([status])
  @@index([isActive])
  @@map("book_copies")
}

model Loan {
  id            String     @id @default(uuid())
  studentId     String
  processedById String
  loanDate      DateTime   @default(now())
  dueDate       DateTime
  returnedAt    DateTime?
  status        LoanStatus @default(AKTIF)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  student     Student    @relation(fields: [studentId], references: [id])
  processedBy User       @relation("LoanProcessedBy", fields: [processedById], references: [id])
  items       LoanItem[]

  @@index([studentId, status])
  @@index([processedById])
  @@index([dueDate])
  @@map("loans")
}

model LoanItem {
  id              String    @id @default(uuid())
  loanId          String
  copyId          String
  returnedAt      DateTime?
  returnCondition String?
  returnNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  loan Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  copy BookCopy @relation(fields: [copyId], references: [id])
  fine Fine?

  @@index([loanId])
  @@index([copyId])
  @@map("loan_items")
}

model Fine {
  id         String     @id @default(uuid())
  loanItemId String     @unique
  type       FineType   @default(TERLAMBAT)
  daysLate   Int        @default(0)
  ratePerDay Decimal    @db.Decimal(12, 2)
  amount     Decimal    @db.Decimal(12, 2)
  status     FineStatus @default(BELUM_DIBAYAR)
  note       String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  loanItem LoanItem     @relation(fields: [loanItemId], references: [id])
  payment  FinePayment?

  @@index([status])
  @@map("fines")
}

model FinePayment {
  id            String        @id @default(uuid())
  fineId        String        @unique
  receivedById  String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  receiptNumber String        @unique
  paidAt        DateTime      @default(now())
  note          String?

  fine       Fine @relation(fields: [fineId], references: [id])
  receivedBy User @relation(fields: [receivedById], references: [id])

  @@index([receivedById])
  @@index([paidAt])
  @@map("fine_payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
